# Server Config
# PORT: Port to run the proxy server on (default: 8082)
PORT=8082

# Proxy API Key (optional - protects your proxy from unauthorized access)
# If blank or "<replaceme>", a random session key is auto-generated on startup
# (format: 16chars.16chars, e.g., "aBcD1234eFgH5678.XyZ90123aBcD4567")
PROXY_API_KEY="<replaceme>"


# NVIDIA NIM Config
# Get your API key at https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY="<replaceme>"
NIM_MAX_TOKENS=202000

# Thinking/Reasoning Mode (DeepSeek V4 Flash/Pro)
# Set to true for models with reasoning/thinking (DeepSeek V4 Flash)
# Set to false for models without reasoning (DeepSeek V4 Pro, most others)
NIM_THINKING=true

# Reasoning effort level: "low", "medium", or "high"
NIM_REASONING_EFFORT=high


# Model Configuration
# Maps NIM models to Claude Code model selector by position (comma-separated):
#
#   Claude Code /model selector:          Claude API Model ID:
#   ─────────────────────────────────     ─────────────────────────────────
#   Default (Sonnet 4.6) – 1M context     claude-sonnet-4-6
#   Sonnet (1M context)                   claude-sonnet-4-6
#   Opus 4.7 (1M context)                 claude-opus-4-7
#   Haiku 4.5 (200k context)              claude-haiku-4-5-20251001
#
# MODEL format: owner/model-name (comma-separated list)
# Position 1 = Sonnet/Default, Position 2 = Opus, Position 3 = Haiku
#
# 1 model (all Claude tiers → same NIM model):
#   MODEL="deepseek-ai/deepseek-v4-flash"
#
# 2 models (Sonnet+Opus → first, Haiku → second):
#   MODEL="qwen/qwen3-coder-480b-a35b-instruct,deepseek-ai/deepseek-v4-flash"
#
# 3 models (each Claude tier → different NIM model):
#   MODEL="qwen/qwen3-coder-480b-a35b-instruct,minimaxai/minimax-m2.7,deepseek-ai/deepseek-v4-flash"
#
# ⚠️ Context Window Requirements:
#   Claude enforces hard context window limits - your NIM models MUST meet them:
#     - Sonnet & Opus positions:  1M token context window minimum
#     - Haiku position:           200k token context window minimum
#   Models with smaller windows will cause errors or truncation.
#   NIM_MAX_TOKENS is the MAX OUTPUT cap (default 202k), NOT the context window size.
#   If auto-compacting issues occur, lower DISCORD_COMPACT_THRESHOLD/DISCORD_MAX_TOKENS.
#
# Popular NIM models:
#   "deepseek-ai/deepseek-v4-flash"      - DeepSeek V4 Flash (fast, reasoning on)  → NIM_THINKING=true
#   "deepseek-ai/deepseek-v4-pro"        - DeepSeek V4 Pro (full power, no thinking) → NIM_THINKING=false
#   "qwen/qwen3-coder-480b-a35b-instruct" - Qwen 3 Coder 480B
#   "minimaxai/minimax-m2.7"              - MiniMax M2.7
#   "meta/llama3-70b-instruct"            - Llama 3 70B
MODEL="deepseek-ai/deepseek-v4-flash"


# Provider Config (Rate Limiting)
# PROVIDER_RATE_LIMIT: Maximum requests per time window (default: 40 for NVIDIA NIM)
# PROVIDER_RATE_WINDOW: Time window in seconds (default: 60 for 1 minute)
# PROVIDER_MAX_CONCURRENCY: Maximum simultaneous API streams (default: 5)
# Example: 40 requests per 60 seconds = 40 req/min (NVIDIA NIM free tier)
# Adjust if you have a higher tier
PROVIDER_RATE_LIMIT=40
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=5


# HTTP client timeouts (seconds) for provider API requests
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=2


# ---------------------------------------------------------------------------
# Server type: "stream" or "buffer"
#   stream  → pass-through SSE, tokens arrive live (may fail mid-stream)
#   buffer  → accumulate full Nvidia response, retry on failure, send as JSON
SERVER_TYPE=stream

# Buffer-specific settings (ignored when SERVER_TYPE=stream)
# Max seconds to wait for Nvidia to respond before retrying
PROVIDER_MAX_WAIT_TIME=30
# Number of retry attempts before giving up (0 = endless retries)
PROVIDER_RETRY_ON_TRUNCATION=3
# Base delay (seconds) between retries (exponential backoff applied)
PROVIDER_RETRY_DELAY=1.0
# ---------------------------------------------------------------------------


# Optimization Settings (all default to true)
# These speed up Claude Code by mocking/skipping unnecessary requests
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true
# Block recap requests when you return after stepping away (saves ~32000 tokens)
ENABLE_RECAP_SKIP=true


# ============================================================================
# Discord Bot Configuration (Optional)
# ============================================================================
# Enable Discord bot integration (default: false)
# When false, the bot will not start even if DISCORD_BOT_TOKEN is set
DISCORD_ENABLED=false

# Get bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=""

# Guild (server) IDs the bot is locked to (comma-separated for multiple servers)
DISCORD_GUILD_ID=0
# Example with multiple servers: DISCORD_GUILD_ID=123456789,987654321

# Channel IDs for control panel (comma-separated for multiple channels)
DISCORD_CONTROL_CHANNEL_ID=0
# Example with multiple control channels: DISCORD_CONTROL_CHANNEL_ID=123456789,987654321

# Category IDs where conversation channels are created (comma-separated)
DISCORD_CONVERSATION_CATEGORY_ID=0
# Example with multiple categories: DISCORD_CONVERSATION_CATEGORY_ID=123456789,987654321

# Specific channel IDs for conversation (alternative to categories, comma-separated)
# If set, the bot will respond in these specific channels
# Can be combined with categories (bot will respond in specified channels OR channels in categories)
# Example: DISCORD_CONVERSATION_CHANNEL_ID=123456789,987654321
DISCORD_CONVERSATION_CHANNEL_ID=

# Owner configuration (your Discord user ID)
DISCORD_OWNER_ID=0

# If true, only owner can use the bot; if false, anyone in the server can use it
DISCORD_OWNER_ONLY=true

# Token Management for Conversation Compaction
DISCORD_MAX_TOKENS=202000
DISCORD_COMPACT_THRESHOLD=0.8

# Rate Limiting (per-channel cooldown)
DISCORD_USER_COOLDOWN=10
DISCORD_SERVER_LIMIT=20
DISCORD_SERVER_WINDOW=60

# System Prompt - Customizes bot personality
DISCORD_SYSTEM_PROMPT="You are a helpful Discord bot. Be friendly, casual, and conversational. Talk like a normal person - don't use formal analysis headers, bullet points, or structured formatting unless specifically asked. Keep responses natural and direct."

# Skip Files - Ignore messages with attachments (future feature to process files)
DISCORD_SKIP_FILES=true

# Message Split Threshold - Split messages at this character count (Discord limit: 2000)
DISCORD_SPLIT_THRESHOLD=1900

# Auto-Compact - Automatically summarize conversations when token threshold is reached
DISCORD_AUTO_COMPACT=true

# ============================================================================
# Discord Bot Command Toggles (Optional)
# ============================================================================
# Set to false to disable specific slash commands. All commands default to true.

# /ask - Ask NIM a question with conversation history
DISCORD_CMD_ASK=true

# /compact - Summarize conversation and restart
DISCORD_CMD_COMPACT=true

# /new - Clear conversation without summary
DISCORD_CMD_NEW=true

# /status - Show bot and rate limit status
DISCORD_CMD_STATUS=true

# /download - Download conversation history as markdown
DISCORD_CMD_DOWNLOAD=true

# /block - Block a user from using the bot (owner only)
DISCORD_CMD_BLOCK=true

# /unblock - Unblock a user (owner only)
DISCORD_CMD_UNBLOCK=true

# /blocked - List blocked users (owner only)
DISCORD_CMD_BLOCKED=true

# /newchannel - Create a new AI conversation channel
DISCORD_CMD_NEWCHANNEL=true
