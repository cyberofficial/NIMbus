# NIMbus Configuration
# Copy this file to .env and configure as needed
# All values below are the actual defaults used by the code

# ════════════════════════════════════════════════════════════════════════════
# CORE SERVER SETTINGS
# ════════════════════════════════════════════════════════════════════════════
# Port to run the proxy server on
PORT=8082

# Host address to bind to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Proxy API Key (optional - protects your proxy from unauthorized access)
# If blank or "<replaceme>", a random session key is auto-generated on startup
# Format: 16chars.16chars (e.g., "aBcD1234eFgH5678.XyZ90123aBcD4567")
PROXY_API_KEY="<replaceme>"


# ════════════════════════════════════════════════════════════════════════════
# NVIDIA NIM CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
# Get your API key at https://build.nvidia.com/settings/api-keys
NVIDIA_NIM_API_KEY="<replaceme>"

# Model(s) to use - comma-separated, mapped by position to Claude tiers:
#   1 model:  All tiers → model[0]
#   2 models: Sonnet+Opus → model[0], Haiku → model[1]
#   3 models: Sonnet → model[0], Opus → model[1], Haiku → model[2]
#   4 models: Sonnet → 0, Opus → 1, Haiku → 2, Fable → 3
# Format: owner/model-name (e.g., "nvidia/nemotron-3-ultra-550b-a55b")
# Special value: "windows:settings.json" reads models from Claude Code settings.json
MODEL="nvidia/nemotron-3-super-120b-a12b"

# Fable model override (optional) - defaults to Opus model if unset
# Supports [1m] suffix for 1M context (e.g., "deepseek-ai/deepseek-v4-pro[1m]")
FABLE_OVERRIDE=""


# ════════════════════════════════════════════════════════════════════════════
# NIM MODEL PARAMETERS (passed directly to NVIDIA NIM API)
# ════════════════════════════════════════════════════════════════════════════
# Maximum output tokens per request
# Acts as a cap: if Claude sends max_tokens=32000 but this is 16384, 16384 will be sent instead
NIM_MAX_TOKENS=32000

# Enable thinking/reasoning content (Nemotron 3 Ultra/Super, DeepSeek V4 Flash)
# true = models WITH reasoning, false = models WITHOUT reasoning (DeepSeek V4 Pro, Qwen, etc.)
NIM_THINKING=true

# Enable thinking globally - if false, disables thinking for ALL models regardless of NIM_THINKING
NIM_ENABLE_THINKING=true

# Reasoning budget - max tokens allocated for model "thinking" (0 = auto from model config, -1 = unlimited)
# Nemotron 3 Ultra (500B): max 16384, Nemotron 3 Super (120B/110B): max 32768
NIM_REASONING_BUDGET=0

# Default reasoning effort: "low", "medium", or "high"
NIM_REASONING_EFFORT=high

# JSON mapping of Claude effort levels to model-specific values
# Format: {"model-pattern": {"claude-effort": "model-value", ...}}
# Example DeepSeek: '{"deepseek": {"xhigh": "max", "high": "high", "medium": "medium", "low": "low", "ultracode": "max"}}'
# See reasoning_effort_presets.json for presets
NIM_REASONING_EFFORT_MAPPINGS=

# Chat template kwargs (explicit thinking control) - only ONE of low/medium/high should be true
NIM_CHAT_TEMPLATE_ENABLE_THINKING=true
NIM_CHAT_TEMPLATE_LOW_EFFORT=false
NIM_CHAT_TEMPLATE_MEDIUM_EFFORT=false
NIM_CHAT_TEMPLATE_HIGH_EFFORT=false


# ════════════════════════════════════════════════════════════════════════════
# PROVIDER RATE LIMITING (NVIDIA NIM free tier defaults)
# ════════════════════════════════════════════════════════════════════════════
# Maximum requests per time window
PROVIDER_RATE_LIMIT=40

# Time window in seconds
PROVIDER_RATE_WINDOW=60

# Maximum concurrent streams to NVIDIA
PROVIDER_MAX_CONCURRENCY=5

# Adaptive rate limiting: auto-restore to initial RPM after N successful requests without 429
# 0 = disabled (manual <nimrpm:reset> only)
NIM_RPM_RESET=1


# ════════════════════════════════════════════════════════════════════════════
# HTTP CLIENT TIMEOUTS (seconds)
# ════════════════════════════════════════════════════════════════════════════
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=2


# ════════════════════════════════════════════════════════════════════════════
# REQUEST QUEUE (v2.0.7+) - Prevents NVIDIA worker limit errors (32 concurrent max)
# ════════════════════════════════════════════════════════════════════════════
REQUEST_QUEUE_ENABLED=true
REQUEST_QUEUE_MAX_CONCURRENT=32
REQUEST_QUEUE_MAX_SIZE=600
REQUEST_QUEUE_TIMEOUT=300.0
REQUEST_QUEUE_NUM_WORKERS=4
REQUEST_QUEUE_DISCORD_PRIORITY=2
REQUEST_QUEUE_API_PRIORITY=1


# ════════════════════════════════════════════════════════════════════════════
# SERVER MODE
# ════════════════════════════════════════════════════════════════════════════
# stream = pass-through SSE (live tokens, may fail mid-stream)
# buffer = accumulate full response, retry on failure, send as JSON
SERVER_TYPE=stream

# Mirror raw NVIDIA reply to console (one timestamped line per chunk)
# THINKING = reasoning_content, REPLY = generated text. Very chatty - off by default.
SHOW_NIM_REPLY=false

# Buffer mode settings (ignored when SERVER_TYPE=stream)
PROVIDER_MAX_WAIT_TIME=30
PROVIDER_RETRY_ON_TRUNCATION=3
PROVIDER_RETRY_DELAY=1.0
RESOURCE_EXHAUSTED_RETRIES=10


# ════════════════════════════════════════════════════════════════════════════
# OPTIMIZATION SETTINGS (speed up Claude Code by mocking/skipping unnecessary requests)
# ════════════════════════════════════════════════════════════════════════════
# Fast command prefix detection
FAST_PREFIX_DETECTION=true

# Mock quota/network probe requests
ENABLE_NETWORK_PROBE_MOCK=true

# Skip title generation requests
ENABLE_TITLE_GENERATION_SKIP=true

# Skip suggestion mode requests (DISABLED: detection produces false positives)
ENABLE_SUGGESTION_MODE_SKIP=false

# Mock filepath extraction
ENABLE_FILEPATH_EXTRACTION_MOCK=true

# Block recap requests when returning after stepping away (DISABLED: blocks legitimate recaps)
ENABLE_RECAP_SKIP=false


# ════════════════════════════════════════════════════════════════════════════
# MODEL SWAPPER (dynamic model switching via <modelswap:model-name> chat tag)
# ════════════════════════════════════════════════════════════════════════════
SWAPPER_ENABLED=false
SWAPPER_TEST_PROMPT="Please reply with pong only, nothing else"
SWAPPER_TEST_TIMEOUT=120.0


# ════════════════════════════════════════════════════════════════════════════
# MCP SERVER SETTINGS (used when running with --mcp flag)
# ════════════════════════════════════════════════════════════════════════════
# Web search fetch timeout (seconds)
WEB_SEARCH_FETCH_TIMEOUT=10.0

# Cache TTL in seconds (max 3600, 0 = disabled)
MCP_CACHE_TTL=600

# Use headless browser for fetch_page (true = fast HTTP, false = visible Playwright browser)
MCP_BROWSER_HEADLESS=true

# Enable verbose web search SSE logging for debugging
WEB_SEARCH_DEBUG=false


# ════════════════════════════════════════════════════════════════════════════
# DISCORD BOT CONFIGURATION (optional)
# ════════════════════════════════════════════════════════════════════════════
# Enable Discord bot integration
DISCORD_ENABLED=false

# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=""

# Guild (server) IDs bot is locked to (comma-separated for multiple)
DISCORD_GUILD_ID=0

# Control panel channel IDs (comma-separated)
DISCORD_CONTROL_CHANNEL_ID=0

# Conversation category IDs where bot creates channels (comma-separated)
DISCORD_CONVERSATION_CATEGORY_ID=0

# Specific conversation channel IDs (alternative to categories, comma-separated)
DISCORD_CONVERSATION_CHANNEL_ID=""

# Your Discord user ID (owner privileges)
DISCORD_OWNER_ID=0

# If true, only owner can use the bot
DISCORD_OWNER_ONLY=true

# Token management for conversation compaction
DISCORD_MAX_TOKENS=202000
DISCORD_COMPACT_THRESHOLD=0.8

# Rate limiting (per-channel cooldown)
DISCORD_USER_COOLDOWN=10
DISCORD_SERVER_LIMIT=20
DISCORD_SERVER_WINDOW=60

# System prompt for Discord conversations
DISCORD_SYSTEM_PROMPT="You are a helpful Discord bot. Be friendly, casual, and conversational. Talk like a normal person - don't use formal analysis headers, bullet points, or structured formatting unless specifically asked. Keep responses natural and direct."

# Skip messages with attachments (future: file processing)
DISCORD_SKIP_FILES=true

# Message split threshold (Discord limit: 2000)
DISCORD_SPLIT_THRESHOLD=1900

# Auto-compact when token threshold reached
DISCORD_AUTO_COMPACT=true

# Optional: separate model for Discord bot (falls back to MODEL if empty)
DISCORD_MODEL=""

# Command prefix for text commands (e.g., !!ask)
DISCORD_COMMAND_PREFIX=!!

# Require @mention to trigger responses in conversation channels
DISCORD_REQUIRE_MENTION=true

# Slash command toggles (all default to true)
DISCORD_CMD_ASK=true
DISCORD_CMD_COMPACT=true
DISCORD_CMD_NEW=true
DISCORD_CMD_STATUS=true
DISCORD_CMD_DOWNLOAD=true
DISCORD_CMD_BLOCK=true
DISCORD_CMD_UNBLOCK=true
DISCORD_CMD_BLOCKED=true
DISCORD_CMD_NEWCHANNEL=true

# Prefix command toggles (when using !! prefix)
DISCORD_CMD_PREFIX_ASK=true
DISCORD_CMD_PREFIX_COMPACT=true
DISCORD_CMD_PREFIX_NEW=true
DISCORD_CMD_PREFIX_STATUS=true

# Discord web search integration
DISCORD_ENABLE_WEB_SEARCH=true
DISCORD_WEB_SEARCH_MAX_RESULTS=10
DISCORD_WEB_SEARCH_MAX_ITERATIONS=10
DISCORD_WEB_SEARCH_MAX_RESULT_SIZE=5000
DISCORD_WEB_SEARCH_INCLUDE_IN_HISTORY=true

# Use visible browser for Discord web search (false = headless HTTP)
DISCORD_BROWSER_HEADLESS=true


# ════════════════════════════════════════════════════════════════════════════
# DIRECT ENVIRONMENT VARIABLES (not managed by settings.py)
# These are read directly via os.getenv() by various components
# ════════════════════════════════════════════════════════════════════════════

# TikToken cache directory (default: ~/.cache/tiktoken)
# TIKTOKEN_CACHE_DIR=/path/to/tiktoken/cache

# Claude Code config directory for setup wizard (default: ~/.config/claude)
# CLAUDE_CONFIG_DIR=/path/to/claude/config

# XDG config home for cross-platform config directories
# XDG_CONFIG_HOME=/path/to/config

# UV project environment for start_server.py (venv path)
# UV_PROJECT_ENVIRONMENT=/path/to/venv

# Playwright browsers path (for web search browser automation)
# PLAYWRIGHT_BROWSERS_PATH=/path/to/playwright/browsers
